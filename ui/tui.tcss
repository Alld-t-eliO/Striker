Screen {
    background: #0a0a12;
    color: #c8c8d8;
}

#banner {
    color: #00e5ff;
    text-style: bold;
    padding: 1 2;
}

#byline {
    color: #7a5cff;
    padding: 0 2;
}

#columns {
    height: 1fr;
    padding: 1 2;
}

#left, #center, #right {
    width: 1fr;
    padding: 0 1;
}

.panel_title {
    color: #ff2e88;
    text-style: bold;
}

#system_panel, #status_panel, #modules, #warning,
#menu1, #menu2, #menu3, #menu4, #prompt {
    padding: 0 1;
}

#warning {
    color: #ffb020;
}

#offensive_warning {
    background: #2a0a0a;
    color: #ff8888;
    text-style: bold;
    padding: 1 2;
    border: round #ff5555;
}

#offensive_live {
    background: #12121c;
    color: #ffaa88;
    padding: 1 2;
    border: round #ff5555;
}

#offensive_form, #offensive_buttons {
    padding: 1 2;
    height: auto;
}

#footer, #footer_text {
    color: #555;
    padding: 0 2;
}

#status_panel_live, #live {
    background: #12121c;
    color: #00ffaa;
    padding: 1 2;
    border: round #00e5ff;
}

#input_area {
    padding: 1 2;
    height: auto;
}

#urls_scroll {
    height: 6;
    border: round #333;
    padding: 0 1;
}

Button {
    margin: 0 1;
}